#!/usr/bin/env bash
function sshrc() {
    local SSHHOME=${SSHHOME:=~}
    if [ -f "$SSHHOME/.sshrc" ]; then
        local files=.sshrc
        if [ -d "$SSHHOME/.sshrc.d" ]; then
            files="$files .sshrc.d"
        fi
        if [ -z "$CMDARG" ] && [ ! -e "$SSHHOME/.sshrc.d/.hushlogin" ]; then
            WELCOME_MSG="
                if [ ! -e ~/.hushlogin ]; then
                    if [ -e /etc/motd ]; then cat /etc/motd; fi
                    if [ -e /etc/update-motd.d ]; then run-parts /etc/update-motd.d/ 2>/dev/null; fi
                    last -F \$USER 2>/dev/null | grep -v 'still logged in' | head -n1 | awk '{print \"Last login:\",\$4,\$5,\$6,\$7,\$8,\"from\",\$3;}'
                fi
                "
        else
            WELCOME_MSG=""
        fi
        local payload remote_cmd
        # $files is deliberately unquoted: it is a space-separated list of names
        # shellcheck disable=SC2086
        payload=$(tar czf - -h -C "$SSHHOME" $files | openssl enc -base64; exit "${PIPESTATUS[0]}") || {
            echo >&2 "sshrc: failed to archive $files in $SSHHOME"
            return 1
        }
        # The script below is sent to the server as a single double-quoted
        # string with \$ escapes for what the server must expand itself. The
        # base64 blobs are spliced in by ending the double quote, writing a
        # $'...' literal around a $(...) that runs here, and reopening it.
        # ShellCheck warns about that pattern, but it is intended.
        # shellcheck disable=SC1078,SC1079,SC2027
        remote_cmd="
            command -v openssl >/dev/null 2>&1 || { echo >&2 \"sshrc requires openssl to be installed on the server, but it's not. Aborting.\"; exit 1; }
            $WELCOME_MSG
            SSHHOME=\$(mktemp -d -t .$(whoami).sshrc.XXXX) || { echo >&2 \"sshrc: mktemp failed on the server. Aborting.\"; exit 1; }
            export SSHHOME
            export SSHRCCLEANUP=\$SSHHOME
            trap \"rm -rf \$SSHRCCLEANUP; exit\" 0
            echo $'"$(openssl enc -base64 < "${BASH_SOURCE[0]}")"' | tr -s ' ' $'\n' | openssl enc -base64 -d > \$SSHHOME/sshrc
            chmod +x \$SSHHOME/sshrc

            echo $'"$( cat << 'EOF' | openssl enc -base64
                if [ -r /etc/profile ]; then source /etc/profile; fi
                if [ -r ~/.bash_profile ]; then source ~/.bash_profile
                elif [ -r ~/.bash_login ]; then source ~/.bash_login
                elif [ -r ~/.profile ]; then source ~/.profile
                fi
                export PATH=$PATH:$SSHHOME
                source $SSHHOME/.sshrc;
EOF
                )"' | tr -s ' ' $'\n' | openssl enc -base64 -d > \$SSHHOME/sshrc.bashrc

            echo $'"$( cat << 'EOF' | openssl enc -base64
#!/usr/bin/env bash
                exec bash --rcfile <(echo '
                [ -r /etc/profile ] && source /etc/profile
                if [ -r ~/.bash_profile ]; then source ~/.bash_profile
                elif [ -r ~/.bash_login ]; then source ~/.bash_login
                elif [ -r ~/.profile ]; then source ~/.profile
                fi
                source '$SSHHOME'/.sshrc;
                export PATH=$PATH:'$SSHHOME'
                ') "$@"
EOF
                )"' | tr -s ' ' $'\n' | openssl enc -base64 -d > \$SSHHOME/bashsshrc
            chmod +x \$SSHHOME/bashsshrc

            echo $'"$payload"' | tr -s ' ' $'\n' | openssl enc -base64 -d | tar mxzf - -C \$SSHHOME
            export SSHHOME=\$SSHHOME
            echo $'"$(printf '%s\n' "$CMDARG" | openssl enc -base64)"' | tr -s ' ' $'\n' | openssl enc -base64 -d >> \$SSHHOME/sshrc.bashrc
            bash --rcfile \$SSHHOME/sshrc.bashrc
            "
        # The whole payload travels as a single ssh argument, so the limit that
        # matters is the length of that argument (Linux caps one argument at
        # 128KiB, MAX_ARG_STRLEN), on both this machine and the server, not
        # ARG_MAX, which is for all arguments combined. Check the real size.
        local max_cmd_size=${SSHRC_MAX_CMD_SIZE:-131072}
        local cmd_size
        cmd_size=$(printf %s "$remote_cmd" | LC_ALL=C wc -c)
        if [ "$cmd_size" -ge "$max_cmd_size" ]; then
            echo >&2 ".sshrc.d and .sshrc files are too large to send"
            echo >&2 "command size: $cmd_size bytes, limit: $max_cmd_size bytes (override with SSHRC_MAX_CMD_SIZE)"
            return 1
        fi
        ssh -t "${SSHARGS[@]}" -- "$DOMAIN" "$remote_cmd"
    else
        echo "No such file: $SSHHOME/.sshrc" >&2
        return 1
    fi
}

# The ssh options that take a value (e.g. -p 22), one letter each. Every other
# option is a plain flag (e.g. -v, -N) that stands alone.
SSH_VALUE_OPTIONS=BbcDEeFIiJLlmOoPpQRSWw

# Succeeds if the ssh option word $1 needs the *next* word as its value.
#
# ssh lets several single-letter options share one word, as in "-vp 22", and
# lets a value follow its letter directly, as in "-p22" or "-oBatchMode=yes".
# Reading left to right, the first letter that takes a value consumes the rest
# of the word. So the value is in the next word only if that letter is last.
#
#   -v       no value letters       -> fails
#   -vp      "p" is last            -> succeeds, "22" is in the next word
#   -p22     "p" has "22" after it  -> fails, value is attached
#   -vp22    same                   -> fails
function sshrc_option_needs_next_word() {
  local letters=${1#-} i
  for ((i = 0; i < ${#letters}; i++)); do
    if [[ $SSH_VALUE_OPTIONS == *"${letters:i:1}"* ]]; then
      ((i == ${#letters} - 1))
      return
    fi
  done
  return 1
}

# Parse the command line "$@" into SSHARGS (options for ssh), DOMAIN (the host)
# and CMDARG (an optional command to run there). Anything from a previous call
# is discarded.
function sshrc_parse() {
  local endopts=
  SSHARGS=()
  DOMAIN=
  CMDARG=
  while [[ -n $1 ]]; do
    if [[ -z $endopts && $1 == -- ]]; then
      endopts=1
    elif [[ -z $endopts && $1 == -* ]]; then
      if sshrc_option_needs_next_word "$1"; then
        SSHARGS+=("$1" "$2")
        shift
      else
        SSHARGS+=("$1")
      fi
    elif [ -z "$DOMAIN" ]; then
      DOMAIN="$1"
    else
      local semicolon
      semicolon=$([[ "$*" = *[![:space:]]* ]] && echo '; ')
      CMDARG="$*$semicolon exit"
      return
    fi
    shift
  done
  if [ -z "$DOMAIN" ]; then
    ssh "${SSHARGS[@]}"; return 1
  fi
}

# Only run when executed, so the functions can also be sourced and reused
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    command -v openssl >/dev/null 2>&1 || { echo >&2 "sshrc requires openssl to be installed locally, but it's not. Aborting."; exit 1; }
    sshrc_parse "$@" && sshrc
    exit
fi
